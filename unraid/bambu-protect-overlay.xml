<?xml version="1.0" encoding="UTF-8"?>
<Container version="2">
  <Name>Bambu-Protect-Overlay</Name>
  <Repository>ghcr.io/mtnears/bambu-protect-overlay:latest</Repository>
  <Registry>https://github.com/mtnears/bambu-protect-overlay/pkgs/container/bambu-protect-overlay</Registry>
  <Network>host</Network>
  <Privileged>false</Privileged>
  <ExtraParams>--cap-add=NET_ADMIN --restart=unless-stopped --log-opt max-size=50m --log-opt max-file=3</ExtraParams>
  <Shell>sh</Shell>
  <Support>https://github.com/mtnears/bambu-protect-overlay/issues</Support>
  <Project>https://github.com/mtnears/bambu-protect-overlay</Project>
  <Overview>Exposes Bambu Lab printer cameras to UniFi Protect with live MQTT data burned into each video stream.</Overview>
  <Category>HomeAutomation: MediaApp:Video</Category>
  <WebUI>http://[IP]:1984/</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/mtnears/bambu-protect-overlay/main/unraid/bambu-protect-overlay.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/mtnears/bambu-protect-overlay/main/unraid/icon.svg</Icon>
  <Config Name="Appdata" Target="/config" Default="/mnt/user/appdata/bambu-protect-overlay" Mode="ro" Description="Persistent directory containing config.yaml." Type="Path" Display="always" Required="true" Mask="false"/>
  <Config Name="Timezone" Target="TZ" Default="Etc/UTC" Mode="" Description="IANA timezone, for example America/Los_Angeles." Type="Variable" Display="always" Required="true" Mask="false"/>
</Container>
